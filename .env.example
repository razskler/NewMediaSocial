# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
#   cp .env.example .env
#
# Generate the secrets with:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────

# Required: the domain pointing at this VPS (DNS A record).
DOMAIN=social.example.com

# Required: signing secret for auth tokens.
# Generate: openssl rand -hex 32
JWT_SECRET=

# Required: MongoDB root password.
# Generate: openssl rand -hex 16
MONGO_PASSWORD=

# Required: Postgres password for the auth database.
# Generate: openssl rand -hex 16
POSTGRES_PASSWORD=

# Optional: shared "anon" API key between the app and GoTrue.
# Any string works; generate one for good measure.
ANON_KEY=anon-key-change-me
