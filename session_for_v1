export async function getFeed(options: { viewerId?: string | null; cursor?: string | null }): Promise<{ posts: Post[]; nextCursor: string | null }> {
  const db = await readyDb();
  const query: Filter<PostDoc> = cursor ? { _id: { $lt: new ObjectId(cursor) } } : {};
  const docs = await db.collection<PostDoc>("posts")
    .find(query)
    .sort({ _id: -1 })
    .limit(PAGE_SIZE + 1)
    .toArray();

  const hasMore = docs.length > PAGE_SIZE;
  const page = hasMore ? docs.slice(0, PAGE_SIZE) : docs;

  let likedIds: Set<string> = new Set();
  if (viewerId && page.length > 0) {
    const likes = await db.collection("likes")
      .find({ userId: viewerId, postId: { $in: page.map((d) => d._id) } })
      .toArray();
    likedIds = new Set(likes.map((l) => l.postId.toHexString()));
  }

  return {
    posts: page.map((d) => ({
      id: d._id.toHexString(),
      authorId: d.authorId,
      authorName: d.authorName,
      text: d.text,
      createdAt: d.createdAt.toISOString(),
      likesCount: d.likesCount,
      likedByMe: likedIds.has(d._id.toHexString()),
    })),
    nextCursor: hasMore ? page[page.length - 1]._id.toHexString() : null,
  };
}
